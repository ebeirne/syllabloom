# Safe to expose to the browser. Never place the Clerk secret key in client code.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Server-side only. Required for future protected APIs and Clerk webhooks.
CLERK_SECRET_KEY=sk_test_replace_me

# Server-side only. Supplied by the Neon integration in Vercel.
# For local work, pull Development variables to .env.development.local.
DATABASE_URL=postgresql://replace_me
