# Safe to expose to the browser. Never place the Clerk secret key in client code.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Server-side only. Required for future protected APIs and Clerk webhooks.
CLERK_SECRET_KEY=sk_test_replace_me

# Server-side only. Supplied by the Neon integration in Vercel.
# For local work, pull Development variables to .env.development.local.
DATABASE_URL=postgresql://replace_me

# Server-side only. Never use a VITE_/NEXT_PUBLIC_ prefix or expose this key to the browser.
OPENAI_API_KEY=sk-proj_replace_me
# The card-generation integration currently pins this low-cost model for beta usage.
OPENAI_CARDS_MODEL=gpt-5.4-nano
