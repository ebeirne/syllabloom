{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{.venv/**,.models/**,.git/**,tests/**,.env,.env.*,**/*.log,**/__pycache__/**,**/*.pyc}"
    },
    "api/source-upload-cleanup.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    { "path": "/api/source-upload-cleanup", "schedule": "0 3 * * *" },
    { "path": "/api/ai-usage-cleanup", "schedule": "15 3 * * *" }
  ],
  "rewrites": [
    { "source": "/api/product-events", "destination": "/api/user-data?billing_route=product-events" },
    { "source": "/api/billing-access", "destination": "/api/user-data?billing_route=billing-access" },
    { "source": "/api/stripe-webhook", "destination": "/api/user-data?billing_route=stripe-webhook" },
    { "source": "/api/sessions/latest", "destination": "/api/session-latest" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), microphone=(self)" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ]
}
