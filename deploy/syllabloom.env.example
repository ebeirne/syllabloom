# Copy to /etc/syllabloom.env on the server, then: chmod 600 /etc/syllabloom.env
# systemd reads plain KEY=value lines (no quotes, no "export").

# Marks this as a hosted deployment: requires sign-in and disables local-only shortcuts.
SYLLABLOOM_ENV=production
SYLLABLOOM_HOST=127.0.0.1
SYLLABLOOM_PORT=4174
SYLLABLOOM_UPLOAD_DIR=/var/lib/syllabloom/uploads

CLERK_PUBLISHABLE_KEY=pk_live_replace_me
DATABASE_URL=postgresql://replace_me
OPENAI_API_KEY=sk-proj_replace_me
OPENAI_CARDS_MODEL=gpt-5.4-nano

# Long random string used by the nightly cleanup timer: openssl rand -hex 32
CRON_SECRET=replace_me

# Set to 1 only if you deliberately run a pk_test_ Clerk key in production.
# SYLLABLOOM_PUBLIC_BETA_AUTH=1
