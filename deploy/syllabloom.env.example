# Copy to /etc/syllabloom.env on the server, then: chmod 600 /etc/syllabloom.env
# systemd reads plain KEY=value lines (no quotes, no "export").

# Marks this as a hosted deployment: requires sign-in and disables local-only shortcuts.
SYLLABLOOM_ENV=production
SYLLABLOOM_HOST=127.0.0.1
SYLLABLOOM_PORT=4174
SYLLABLOOM_UPLOAD_DIR=/var/lib/syllabloom/uploads

CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
SYLLABLOOM_PUBLIC_BETA_AUTH=1
DATABASE_URL=postgresql://replace_me
OPENAI_API_KEY=sk-proj_replace_me
OPENAI_CARDS_MODEL=gpt-5.4-nano

# Hosted transcription uses OpenAI when selected; requires ffmpeg and ffprobe.
# SYLLABLOOM_LECTURE_PROVIDER=openai
# SYLLABLOOM_LECTURE_NOTES_MODEL=gpt-5.4-nano
# Alternatively, download a faster-whisper model for local processing.
SYLLABLOOM_WHISPER_MODEL=/var/lib/syllabloom/models/whisper-small

# Long random string used by the nightly cleanup timer: openssl rand -hex 32
CRON_SECRET=replace_me

# Set to 1 only if you deliberately run a pk_test_ Clerk key in production.
# SYLLABLOOM_PUBLIC_BETA_AUTH=1

# Copy the existing beta billing configuration securely; do not reset founders or plans.
# Keep the existing beta URL and Clerk development instance.
# Billing stays disabled until checkout, webhooks, and the portal are verified.
SYLLABLOOM_APP_URL=https://syllabloom.study
SYLLABLOOM_BILLING_ENABLED=false
STRIPE_MODE=test
STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_PRICE_MONTHLY=price_replace_me
STRIPE_PRICE_YEARLY=price_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PORTAL_CONFIGURATION=bpc_replace_me
# Private snapshot of existing Clerk users; these do not consume the next ten slots.
SYLLABLOOM_FOUNDER_IDS=[]
